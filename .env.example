# Copy to .env for local development. .env is gitignored; never commit real values.
#
# Nesting uses a double underscore: DATABASE__APP_URL -> settings.database.app_url

APP__ENV=local
APP__COMPONENT=api
APP__DEBUG=true

# Shared secret for /internal. That router is mounted whenever APP__ENV is not "production",
# so staging serves it publicly -- a staging service with no token set refuses to boot.
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
APP__INTERNAL_TOKEN=local-dev-internal-token

# Three roles, three DSNs. See src/personal_organizer/db/roles.py for why there are three.
#   bootstrap = superuser: creates the extension and the roles (po-db bootstrap)
#   owner     = app_owner: runs Alembic, owns every table
#   app       = app_user:  the runtime role, RLS-bound, owns nothing
DATABASE__BOOTSTRAP_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE__OWNER_URL=postgresql://app_owner:owner-dev-password@localhost:5433/postgres
DATABASE__APP_URL=postgresql://app_user:app-dev-password@localhost:5433/postgres

# Local logs are easier to read unrendered. Deployed environments must use json;
# the settings validator rejects anything else.
LOGGING__LEVEL=INFO
LOGGING__RENDERER=console
LOGGING__PII_PEPPER=local-dev-pepper-not-secret

# Model IDs are settings so a deprecation is a config change, not a code change.
MODELS__CHAT_MODEL=claude-haiku-5-5
MODELS__FALLBACK_MODEL=claude-haiku-4-5
MODELS__EMBEDDING_MODEL=text-embedding-3-small
MODELS__TRANSCRIPTION_MODEL=stt-async-v5
# Optional: a stronger model the agent hands a hard turn to. Unset = no handoff.
# MODELS__STRONG_MODEL=

# Optional locally.
# SENTRY__DSN=
# LANGFUSE__PUBLIC_KEY=
# LANGFUSE__SECRET_KEY=

# Feature flags (Gates 10 and 15).
FLAGS__GROUPS=false
FLAGS__TASKS=false

# WhatsApp Cloud API. Off until the Meta app exists; see docs/runbook-iteration-02.md.
# With ENABLED=true the four credentials below are all required, and the service refuses to
# boot without them. Disabled, /webhooks/whatsapp is not mounted at all.
WHATSAPP__ENABLED=false
# WHATSAPP__APP_SECRET=
# At least 32 characters: uv run python -c "import secrets; print(secrets.token_hex(32))"
# WHATSAPP__VERIFY_TOKEN=
# WHATSAPP__ACCESS_TOKEN=
# WHATSAPP__PHONE_NUMBER_ID=
# Comma-separated E.164: the invite list, for every channel (the GOWA gateway's too). A listed
# number may start onboarding; everyone else gets a one-line "invite-only" reply.
# WHATSAPP__ALLOWED_PHONES=+31612345678

# GOWA, the QR-code WhatsApp gateway (go-whatsapp-web-multidevice), linked to a dedicated SIM;
# see docs/runbook-whatsapp-gateway.md. Independent of WHATSAPP__ENABLED: both may be on. With
# ENABLED=true the basic-auth pair and the webhook secret are required; disabled,
# /webhooks/gowa is not mounted. Locally: docker compose --profile gateway up -d gowa
GOWA__ENABLED=false
# GOWA__BASE_URL=http://localhost:3000
# The gateway's APP_BASIC_AUTH, split in two.
# GOWA__BASIC_AUTH_USER=
# GOWA__BASIC_AUTH_PASSWORD=
# The gateway's WHATSAPP_WEBHOOK_SECRET. At least 32 characters (its default, "secret", is refused).
# GOWA__WEBHOOK_SECRET=
# Only if the gateway holds more than one device.
# GOWA__DEVICE_ID=
# Each reply waits TYPING_DELAY_S plus a random 0..TYPING_JITTER_S, behind a typing indicator.
# GOWA__TYPING_DELAY_S=3
# GOWA__TYPING_JITTER_S=2

# Where browsers reach the api: onboarding links and the Composio callback are built on it.
# An origin only, no path; https when deployed.
APP__PUBLIC_BASE_URL=http://localhost:8000

# Signs onboarding links and the callback state. At least 32 characters; this placeholder is
# refused when deployed. Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
ONBOARDING__LINK_SECRET=local-dev-link-secret-not-a-secret-0000
# ONBOARDING__LINK_TTL_S=900
# The bot's own number, for the wa.me link po-admin invite prints. E.164.
# ONBOARDING__BOT_PHONE=+972501234567

# Composio (Google Calendar connections). Off until the Composio project exists; see
# docs/runbook-iteration-03.md. With ENABLED=true the API key and auth config id are required,
# and so are APP__PUBLIC_BASE_URL and ONBOARDING__LINK_SECRET above.
COMPOSIO__ENABLED=false
# COMPOSIO__API_KEY=
# Our custom Google Calendar auth config (our own OAuth client), from the Composio dashboard: ac_...
# COMPOSIO__CALENDAR_AUTH_CONFIG_ID=

# The LLM (Claude, MODELS__CHAT_MODEL): onboarding talks through it. Worker only. With
# ENABLED=true the key is required, and so is COMPOSIO__ENABLED=true.
AGENT__ENABLED=false
# AGENT__API_KEY=
# AGENT__STRONG_TIMEOUT_S=60  # per-call timeout of MODELS__STRONG_MODEL (chat: REQUEST_TIMEOUT_S)

# Voice notes (Iteration 06): transcribed with MODELS__TRANSCRIPTION_MODEL through Soniox.
# Worker only. With it off, a voice note gets "couldn't catch that, could you type it?".
VOICE__ENABLED=false
# VOICE__API_KEY=
